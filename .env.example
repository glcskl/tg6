# Токен от @BotFather (обязательно)
BOT_TOKEN=

# Указывается в Render-деплое: https://<app>.onrender.com
# Без него бот работает локально через long polling
WEBHOOK_URL=

# Случайная строка для защиты вебхука
WEBHOOK_SECRET=

# Путь вебхука (опционально, по умолчанию /webhook)
HOOK_PATH=/webhook

# Публичный адрес мини-аппы (опционально)
# По умолчанию берётся WEBHOOK_URL + /app/
MINI_APP_URL=